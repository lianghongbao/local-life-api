// 黄页商家模块类型定义

import "base.api"

type ShopCreateRequest {
    Name        string  `json:"name" validate:"required,max=128"`
    Category    int     `json:"category" validate:"required,oneof=1 2 3 4 5 6 7 8 9"`
    Address     string  `json:"address" validate:"required,max=256"`
    Latitude    float64 `json:"latitude,default=0"`
    Longitude   float64 `json:"longitude,default=0"`
    Phone       string  `json:"phone" validate:"required,max=20"`
    Description string  `json:"description,optional"`
    Images      string  `json:"images,optional"`
}

type ShopUpdateRequest {
    IdRequest
    Name        string  `json:"name" validate:"required,max=128"`
    Category    int     `json:"category" validate:"required,oneof=1 2 3 4 5 6 7 8 9"`
    Address     string  `json:"address" validate:"required,max=256"`
    Latitude    float64 `json:"latitude,default=0"`
    Longitude   float64 `json:"longitude,default=0"`
    Phone       string  `json:"phone" validate:"required,max=20"`
    Description string  `json:"description,optional"`
    Images      string  `json:"images,optional"`
}

type ShopItem {
    Id           int64   `json:"id"`
    UserId       int64   `json:"user_id"`
    Nickname     string  `json:"nickname"`
    Avatar       string  `json:"avatar"`
    Name         string  `json:"name"`
    Category     int     `json:"category"`
    Address      string  `json:"address"`
    Latitude     float64 `json:"latitude"`
    Longitude    float64 `json:"longitude"`
    Phone        string  `json:"phone"`
    Description  string  `json:"description"`
    Images       string  `json:"images"`
    Status       int     `json:"status"`
    RejectReason string  `json:"reject_reason"`
    ViewCount    int     `json:"view_count"`
    CreatedAt    string  `json:"created_at"`
    UpdatedAt    string  `json:"updated_at"`
    AreaName     string  `json:"area_name"` // 商家所属区名
    // 同城推荐定位字段
    AreaAdcode   string  `json:"area_adcode"` // 国标 6 位,区/县级
    StreetName   string  `json:"street_name"`
    CityAdcode   string  `json:"city_adcode"`
    CityName     string  `json:"city_name"`
}

type ShopListResponse {
    List  []ShopItem `json:"list"`
    Total int64      `json:"total"`
}

type ShopListRequest {
    PageRequest
    Category   int    `form:"category,default=0"` // 0全部 1家政 2维修 3开锁 4搬家 5跑腿 6美业 7教育 8美食 9其他
    AreaAdcode string `form:"area_adcode,optional"` // 可选:按区过滤;空则全市
    CityAdcode  string `form:"city_adcode,optional"`  // 可选:按市过滤;city 优先
}

type ShopAuditRequest {
    IdRequest
    Status       int    `json:"status" validate:"required,oneof=2 4"` // 2通过 4拒绝
    RejectReason string `json:"reject_reason,optional"`
}
