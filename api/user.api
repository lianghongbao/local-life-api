// 用户模块类型定义

import "base.api"

type LoginRequest {
    Code string `json:"code" validate:"required"` // 微信登录code
}

type LoginResponse {
    Token   string `json:"token"`
    UserId  int64  `json:"user_id"`
    Openid  string `json:"openid"`           // 微信OpenID,排查时前端可直接提供
    Unionid string `json:"unionid,optional"` // 微信UnionID(同主体跨端合并),可能为空
}

type UserProfileResponse {
    Id            int64  `json:"id"`
    Nickname      string `json:"nickname"`
    Avatar        string `json:"avatar"`          // 完整访问 URL(永久有效),前端直接渲染
    AvatarFileKey string `json:"avatar_file_key"` // 原始 file_key(纯路径),前端缓存 + dirty 比较用
    Phone         string `json:"phone"`
    Status        int    `json:"status"`
    CreatedAt     string `json:"created_at"`
}

type UpdateProfileRequest {
    Nickname string `json:"nickname,optional,max=32"`
    Avatar   string `json:"avatar,optional,max=512"`
}

type AdminUserItem {
    Id        int64  `json:"id"`
    Nickname  string `json:"nickname"`
    Avatar    string `json:"avatar"`
    Phone     string `json:"phone"`
    Status    int    `json:"status"`
    CreatedAt string `json:"created_at"`
}

type AdminUserListResponse {
    List  []AdminUserItem `json:"list"`
    Total int64           `json:"total"`
}

type AdminUserDetailResponse {
    Id        int64  `json:"id"`
    Openid    string `json:"openid"`
    Nickname  string `json:"nickname"`
    Avatar    string `json:"avatar"`
    Phone     string `json:"phone"`
    Status    int    `json:"status"`
    CreatedAt string `json:"created_at"`
    UpdatedAt string `json:"updated_at"`
}

type AdminUserBanRequest {
    IdRequest
    Status int `json:"status" validate:"required,oneof=1 2"` // 1解封 2封禁
}

type AdminLoginRequest {
    Username string `json:"username" validate:"required,max=32"`
    Password string `json:"password" validate:"required,max=128"`
}

type AdminLoginResponse {
    Token string `json:"token"`
}
