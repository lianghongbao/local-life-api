# ============================================================
# Docker Compose 环境变量模板
# ============================================================
# 用法:
#   1. cp deploy/.env.example deploy/.env
#   2. 在 deploy/.env 里把 CHANGE_ME_* / 占位值改成真实凭证
#   3. docker compose up -d
#
# deploy/.env 已在 .gitignore 中,不会被误提交

# -------- MySQL --------
# MySQL 的 root 密码。mysql 容器和应用容器用同一个值。
MYSQL_ROOT_PASSWORD=CHANGE_ME

# -------- Redis --------
# Redis 密码。redis 容器和应用容器用同一个值。
REDIS_PASSWORD=CHANGE_ME
# Redis 容器名。容器名只在 compose 的网络里可解析。
REDIS_HOST=redis:6379

# -------- JWT --------
# 至少 32 字符,生产强烈建议 openssl rand -hex 32 生成
AUTH_ACCESS_SECRET=CHANGE_ME_jwt_user_secret_min_32_chars
ADMIN_AUTH_SECRET=CHANGE_ME_jwt_admin_secret_min_32_chars
REFRESH_SECRET=CHANGE_ME_jwt_refresh_secret_min_32_chars

# -------- 微信小程序 --------
WX_APP_ID=CHANGE_ME_wx_appid
WX_APP_SECRET=CHANGE_ME_wx_appsecret

# -------- 腾讯位置服务(LBS) --------
# 申请: https://lbs.qq.com/webservice_v1/guide-geocoder
# 用途: /api/v1/geo/* 一组接口都依赖这个 key
# 不填则所有 geo 接口降级返回空字段
TENCENT_MAP_KEY=CHANGE_ME_tencent_lbs_key

# -------- 阿里云 OSS --------
# Endpoint / Region / Bucket 到阿里云 OSS 控制台拿
OSS_ENDPOINT=oss-<region>.aliyuncs.com
OSS_BUCKET=CHANGE_ME_bucket_name
OSS_REGION=CHANGE_ME_region_id
OSS_ACCESS_KEY_ID=CHANGE_ME_ram_ak
OSS_ACCESS_KEY_SECRET=CHANGE_ME_ram_sk
OSS_ROLE_ARN=acs:ram::<uid>:role/<role-name>
OSS_UPLOAD_HOST=https://<bucket>.<endpoint>
OSS_URL_PREFIX=https://<your-cdn-domain>
OSS_ALLOWED_HOST=<your-cdn-domain>

# ============================================================
# 容器镜像仓库(跟 GitHub repo Vars + Secrets 一致)
# ============================================================
# 公网端点(不带 -vpc)
ACR_REGISTRY_HOST=crpi-<id>.<region>.personal.cr.aliyuncs.com
ACR_NAMESPACE=<your-ns>/<your-repo-prefix>
# 业务镜像名(不含仓库前缀)。compose 的 image: 由 ACR_REGISTRY_HOST/ACR_NAMESPACE/IMAGE_NAME 拼出
IMAGE_NAME=CHANGE_ME_image_name
# docker compose 里 container_name(deploy.yml 健康检查的目标容器)
APP_CONTAINER=CHANGE_ME_container_name

# ECS 上 pull 镜像用的登录凭证
# 注意: GitHub Actions build job push 用的凭据配在 GitHub Secrets,
#       这一对是 ECS 拉取用的,需要在 ACR 控制台单独开 RAM 账号
REGISTRY_USERNAME=CHANGE_ME_acr_ram_user
REGISTRY_PASSWORD=CHANGE_ME_acr_ram_password
