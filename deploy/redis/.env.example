# ============================================================
# Redis 环境变量模板
# ============================================================
# 用法:
#   1. cp .env.example .env
#   2. 把 CHANGE_ME 改成真实值
#   3. docker compose up -d
#
# .env 已在 .gitignore 中,不会被误提交。
#
# 业务应用的 deploy/.env 里要有**同一个** REDIS_PASSWORD ——
# 应用就是拿这个凭证连过来的。
#
# 多个项目共用这一个实例，靠 **DB 号**隔离:
#   DB 0 → local-life-api / chatroom（运行时）
#   DB 1、2 → 预留
#   DB 3 → short-url
#   DB 15 → chatroom 的测试
# DB 号在各自应用的配置里设（short-url 是 REDIS_DB=3）。

REDIS_PASSWORD=CHANGE_ME

# -------- 宿主端口 --------
# 容器内固定 6379，映射到宿主端口。宿主 6379 被本机非 Docker 的 Redis 占了，
# 所以用 16385。容器之间一律连 redis:6379，不受这个端口影响。
REDIS_HOST_PORT=16385

# -------- 容器镜像仓库 --------
# 公网端点(不带 -vpc)。**必须替换成真实值** ——
# 留着占位符 compose 会报 "invalid reference format"。
# 镜像地址长这样:crpi-xxxx.cn-guangzhou.personal.cr.aliyuncs.com/<ns>/<repo>:mysql-8.0
ACR_REGISTRY_HOST=crpi-CHANGE_ME.personal.cr.aliyuncs.com
ACR_NAMESPACE=CHANGE_ME_NAMESPACE
