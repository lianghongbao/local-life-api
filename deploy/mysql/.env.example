# ============================================================
# MySQL 环境变量模板
# ============================================================
# 用法:
#   1. cp .env.example .env
#   2. 把 CHANGE_ME 改成真实值
#   3. docker compose up -d
#
# .env 已在 .gitignore 中,不会被误提交。
#
# 业务应用的 deploy/.env 里要有**同一个** MYSQL_ROOT_PASSWORD ——
# 应用就是拿这个凭证连过来的。

MYSQL_ROOT_PASSWORD=CHANGE_ME

# -------- 容器镜像仓库 --------
# 公网端点(不带 -vpc)。**必须替换成真实值** ——
# 留着占位符 compose 会报 "invalid reference format"。
# 镜像地址长这样:crpi-xxxx.cn-guangzhou.personal.cr.aliyuncs.com/<ns>/<repo>:mysql-8.0
ACR_REGISTRY_HOST=crpi-CHANGE_ME.personal.cr.aliyuncs.com
ACR_NAMESPACE=CHANGE_ME_NAMESPACE
