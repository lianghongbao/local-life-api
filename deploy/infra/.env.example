# ============================================================
# 共享底座环境变量模板
# ============================================================
# 用法:
#   1. cp .env.example .env
#   2. 把 CHANGE_ME 改成真实值
#   3. docker compose up -d
#
# .env 已在 .gitignore 中,不会被误提交。
#
# 注意：local-life-api 和 chatroom 两个仓库各存一份内容相同的本文件。
# 底座只起一套（compose 项目名固定 shared-infra），两边的 .env
# 填**同一套**凭证。

# -------- MySQL --------
# 共享实例的 root 密码。各应用用自己的库名连上去
# （local-life-api 用 local_life，chatroom 用 chatroom）。
MYSQL_ROOT_PASSWORD=CHANGE_ME

# -------- Redis --------
# 共享实例的密码。各应用靠 key 前缀隔离
# （local-life-api 用 local-life: 前缀，chatroom 用 chatroom: 前缀）。
REDIS_PASSWORD=CHANGE_ME

# -------- 容器镜像仓库 --------
# 跟 local-life-api 的 deploy/.env.example 保持一致。
# 公网端点（不带 -vpc）
ACR_REGISTRY_HOST=crpi-<id>.<region>.personal.cr.aliyuncs.com
ACR_NAMESPACE=<your-ns>/<your-repo-prefix>
